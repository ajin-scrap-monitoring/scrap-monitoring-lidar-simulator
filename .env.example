# Development and integration validation runtime settings.
# Host directory mounted into both the simulator and lidar-processing containers.
SCRAP_LIDAR_SIMULATOR_GRPC_SOCKET_HOST_DIR=/opt/ajin/runtime/sockets/lidar-simulator

# Simulator configuration path inside the container.
SCRAP_LIDAR_SIMULATOR_CONFIG=/config/simulator.v2.json
# Mean duration of one filling phase in simulation seconds.
SCRAP_LIDAR_SIMULATOR_MEAN_FILL_DURATION_S=86400
# Center of the per-cycle collection threshold range with a fixed 0.05 half-range.
SCRAP_LIDAR_SIMULATOR_COLLECTION_THRESHOLD_CENTER_RATIO=0.90

# Directory containing the lidar_1.sock and lidar_2.sock scan endpoints.
SCRAP_LIDAR_SIMULATOR_GRPC_SOCKET_DIR=/run/lidar
# Root directory containing one status subdirectory per emulated driver.
SCRAP_LIDAR_SIMULATOR_STATUS_DIR=/status
# Validation identity shared with lidar-processing.
SITE_ID=replace-with-site-id
EDGE_ID=replace-with-edge-id
CONFIG_REVISION=replace-with-config-revision
DEPLOYMENT_REVISION=replace-with-deployment-revision

# Observation receiver address; replace the reserved example domain.
SCRAP_LIDAR_SIMULATOR_OBSERVATION_HOST=visualizer.example
# Observation receiver TCP port.
SCRAP_LIDAR_SIMULATOR_OBSERVATION_PORT=17000
# Simulation interval between observation records.
SCRAP_LIDAR_SIMULATOR_OBSERVATION_INTERVAL_S=1

# Diagnostic recording switch.
SCRAP_LIDAR_SIMULATOR_DIAGNOSTICS_ENABLED=true
# Diagnostic output path inside the container.
SCRAP_LIDAR_SIMULATOR_DIAGNOSTICS_OUTPUT_PATH=/data/diagnostics
