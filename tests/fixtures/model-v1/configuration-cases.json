{
  "cases": [
    {
      "expected": {
        "accepted": true
      },
      "name": "maximum-seed",
      "replace": {
        "path": [
          "seed"
        ],
        "value": 18446744073709551615
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.seed must be at most 18446744073709551615"
      },
      "name": "seed-overflow",
      "replace": {
        "path": [
          "seed"
        ],
        "value": 18446744073709551616
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.seed must be an integer"
      },
      "name": "boolean-seed",
      "replace": {
        "path": [
          "seed"
        ],
        "value": true
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.seed must be an integer"
      },
      "name": "fractional-seed",
      "replace": {
        "path": [
          "seed"
        ],
        "value": 1.0
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": true
      },
      "name": "numeric-version",
      "replace": {
        "path": [
          "config_version"
        ],
        "value": 2.0
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.config_version must be 2"
      },
      "name": "boolean-version",
      "replace": {
        "path": [
          "config_version"
        ],
        "value": true
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.scenario contains unexpected fields: extra"
      },
      "name": "unknown-nested-field",
      "replace": {
        "path": [
          "scenario",
          "extra"
        ],
        "value": 1
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.measurement.sample_rate_hz must be at least $.measurement.rotation_rate_hz"
      },
      "name": "sampling-under-rotation",
      "replace": {
        "path": [
          "measurement",
          "sample_rate_hz"
        ],
        "value": 1
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.measurement.sample_rate_hz must produce at most 32768 points per rotation"
      },
      "name": "sampling-over-frame-limit",
      "replace": {
        "path": [
          "measurement",
          "sample_rate_hz"
        ],
        "value": 327680.0000000001
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": true
      },
      "name": "large-noise",
      "replace": {
        "path": [
          "measurement",
          "distance_noise",
          "limit_m"
        ],
        "value": 20
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": true
      },
      "name": "maximum-diagnostics-limit",
      "replace": {
        "path": [
          "diagnostics",
          "sample_scan_limit_per_sensor"
        ],
        "value": 16
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.diagnostics.sample_scan_limit_per_sensor must be at most 16"
      },
      "name": "diagnostics-limit-overflow",
      "replace": {
        "path": [
          "diagnostics",
          "sample_scan_limit_per_sensor"
        ],
        "value": 17
      },
      "source": "examples/simulator.v2.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.length_unit must be 'm'"
      },
      "name": "wrong-unit",
      "replace": {
        "path": [
          "length_unit"
        ],
        "value": "mm"
      },
      "source": "examples/environment.v1.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.sensors[0].u0 must be a unit vector"
      },
      "name": "non-unit-frame",
      "replace": {
        "path": [
          "sensors",
          0,
          "u0"
        ],
        "value": [
          0,
          0,
          -2
        ]
      },
      "source": "examples/environment.v1.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.sensors must contain at least 1 sensor"
      },
      "name": "empty-sensors",
      "replace": {
        "path": [
          "sensors"
        ],
        "value": []
      },
      "source": "examples/environment.v1.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.boundary_xy_m is invalid: polygon must contain unique vertices"
      },
      "name": "repeated-polygon-node",
      "replace": {
        "path": [
          "boundary_xy_m"
        ],
        "value": [
          [
            0,
            0
          ],
          [
            0,
            0
          ],
          [
            0,
            0
          ]
        ]
      },
      "source": "examples/environment.v1.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.sensors[0].valid_distance_frequencies keys must be decimal integers from 0 through 255"
      },
      "name": "noncanonical-quality-key",
      "replace": {
        "path": [
          "sensors",
          0,
          "valid_distance_frequencies"
        ],
        "value": {
          "01": 1
        }
      },
      "source": "examples/quality-profile.v1.json"
    },
    {
      "expected": {
        "accepted": true
      },
      "name": "maximum-quality-frequency",
      "replace": {
        "path": [
          "sensors",
          0,
          "valid_distance_frequencies"
        ],
        "value": {
          "255": 9223372036854775807
        }
      },
      "source": "examples/quality-profile.v1.json"
    },
    {
      "expected": {
        "accepted": false,
        "error": "$.sensors[0].valid_distance_frequencies.48 must be an integer"
      },
      "name": "boolean-quality-frequency",
      "replace": {
        "path": [
          "sensors",
          0,
          "valid_distance_frequencies"
        ],
        "value": {
          "48": true
        }
      },
      "source": "examples/quality-profile.v1.json"
    },
    {
      "document": "{\"seed\":1,\"seed\":2}",
      "expected": {
        "accepted": false,
        "error": "duplicate JSON field: seed"
      },
      "name": "duplicate-field",
      "source": "examples/simulator.v2.json"
    },
    {
      "document": "{\"seed\":NaN}",
      "expected": {
        "accepted": false,
        "error": "non-finite JSON number is not allowed: NaN"
      },
      "name": "non-finite-number",
      "source": "examples/simulator.v2.json"
    },
    {
      "document": "{}",
      "expected": {
        "accepted": false,
        "error": "$ is missing fields: config_version, diagnostics, environment_path, measurement, observation_transport, quality_profile_path, scenario, seed"
      },
      "name": "missing-fields",
      "source": "examples/simulator.v2.json"
    },
    {
      "document": "[]",
      "expected": {
        "accepted": false,
        "error": "$ must be an object"
      },
      "name": "non-object-root",
      "source": "examples/simulator.v2.json"
    }
  ],
