{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-simulator/contracts/observation/v1/header.schema.json",
  "title": "Load-model observation stream header v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "type",
    "environment_id",
    "run_id",
    "input_fingerprint_sha256",
    "seed",
    "scene"
  ],
  "properties": {
    "observation_version": {
      "const": 1
    },
    "type": {
      "const": "load_model_stream_header"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "scene": {
      "$ref": "#/$defs/scene"
    }
  },
  "$defs": {
    "coordinate2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "coordinate3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "p0_m", "u0", "u90"],
      "properties": {
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "p0_m": {
          "$ref": "#/$defs/coordinate3"
        },
        "u0": {
          "$ref": "#/$defs/coordinate3"
        },
        "u90": {
          "$ref": "#/$defs/coordinate3"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_system",
        "length_unit",
        "angle_unit",
        "boundary_xy_m",
        "floor_z_m",
        "top_z_m",
        "inlet_positions_xy_m",
        "sensors"
      ],
      "properties": {
        "coordinate_system": {
          "const": "right-handed-z-up"
        },
        "length_unit": {
          "const": "m"
        },
        "angle_unit": {
          "const": "deg"
        },
        "boundary_xy_m": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/coordinate2"
          }
        },
        "floor_z_m": {
          "type": "number"
        },
        "top_z_m": {
          "type": "number"
        },
        "inlet_positions_xy_m": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coordinate2"
          }
        },
        "sensors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sensor"
          }
        }
      }
    }
  }
}
