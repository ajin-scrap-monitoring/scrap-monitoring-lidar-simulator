{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-simulator/contracts/observation/v1/observation.schema.json",
  "title": "Load-model observation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "type",
    "sequence",
    "run_id",
    "scenario",
    "surface"
  ],
  "properties": {
    "observation_version": {
      "const": 1
    },
    "type": {
      "const": "load_model_observation"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "surface": {
      "$ref": "#/$defs/surface"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_s",
        "surface_updated_at_s",
        "cycle_index",
        "phase",
        "phase_started_at_s",
        "phase_ends_at_s",
        "phase_duration_s",
        "rate_factor",
        "target_fill_ratio",
        "surface_fill_ratio",
        "surface_volume_m3",
        "current_inlet_index"
      ],
      "properties": {
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "surface_updated_at_s": {
          "type": "number",
          "minimum": 0
        },
        "cycle_index": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": ["filling", "collecting"]
        },
        "phase_started_at_s": {
          "type": "number",
          "minimum": 0
        },
        "phase_ends_at_s": {
          "type": "number",
          "minimum": 0
        },
        "phase_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rate_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface_volume_m3": {
          "type": "number",
          "minimum": 0
        },
        "current_inlet_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_size_m",
        "x_coordinates_m",
        "y_coordinates_m",
        "heights_m"
      ],
      "properties": {
        "cell_size_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "x_coordinates_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "y_coordinates_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "heights_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
