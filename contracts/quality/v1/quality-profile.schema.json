{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-simulator/contracts/quality/v1/quality-profile.schema.json",
  "title": "Synthetic LiDAR quality profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "sensors"],
  "properties": {
    "config_version": {
      "const": 1
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sensorQuality"
      }
    }
  },
  "$defs": {
    "frequencies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807
      }
    },
    "sensorQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_id",
        "valid_distance_frequencies",
        "invalid_distance_frequencies"
      ],
      "properties": {
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_distance_frequencies": {
          "$ref": "#/$defs/frequencies"
        },
        "invalid_distance_frequencies": {
          "$ref": "#/$defs/frequencies"
        }
      }
    }
  }
}
